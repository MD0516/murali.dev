# Required to connect to MongoDB.
MONGODB_URI=

# Required for signing admin session tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Vercel Blob store identifier
BLOB_STORE_ID=

# Vercel Blob read-write token (server-side authentication)
BLOB_READ_WRITE_TOKEN=

# Required only for contact email (Gmail SMTP uses an app password).
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=

# Used only by `npm run seed` to create the initial admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=